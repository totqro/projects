# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
.venv/
venv/
env/
ENV/

# Data & Cache
cache/
ml_models/*
*.json
*.jsonl
!config.json.example
!firebase.json
!data/bet_results.json
!data/analysis_history.json
!data/latest_analysis.json
!data/model_feedback.json
!data/backtest_results.json

# Season-validation record — see the matching block in the repo-root
# .gitignore. Written by CI on an ephemeral runner; committed or lost.
!data/predictions_log.jsonl
!data/market_snapshots/*.json

# Projected playoff bracket — regenerated once a year, served by the web app.
!data/playoff_bracket.json

# The shipped win model: 16 KB of coefficients + calibrators. Tracked because
# the CI artifact round-trip never worked (download-artifact only sees its own
# run's artifacts), so a fresh runner had no model at all. The .pkl files above
# stay ignored — they belong to the quarantined leaky path.
!ml_models/*.json
!mlblines_data/bet_results.json
!mlblines_data/analysis_history.json
!mlblines_data/latest_analysis.json

