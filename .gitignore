# Dependencies
/node_modules
/.pnp
.pnp.js

# Production build
/build

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
.venv/
venv/
env/

# NHL caches & models
nhllines/cache/
nhllines/.venv/
nhllines/.vscode/

# The shipped win model is 16 KB of JSON coefficients, and it is tracked: CI
# runs on an ephemeral runner, and actions/download-artifact can only see
# artifacts from its OWN run, so the artifact round-trip never restored
# anything. Committed, the daily run always has the gated model — and git
# history records exactly which coefficients served which day.
nhllines/ml_models/*
!nhllines/ml_models/*.json
# The .pkl files belong to the quarantined leaky XGBoost path — never tracked.

# MLB caches & models
mlblines/cache/
mlblines/ml_models/

# Config with secrets (keep examples)
nhllines/config.json
mlblines/config.json

# Data files — only track the three key data files per sport
nhllines/data/*
!nhllines/data/bet_results.json
!nhllines/data/analysis_history.json
!nhllines/data/latest_analysis.json

# The 2026-27 season-validation record: predictions timestamped before puck
# drop, and the devigged market consensus they get scored against. Both are
# written by CI on an ephemeral runner, so they only survive if committed —
# and neither can be reconstructed after the fact.
!nhllines/data/predictions_log.jsonl
!nhllines/data/market_snapshots/
!nhllines/data/playoff_bracket.json

mlblines/mlbdata/*
!mlblines/mlbdata/bet_results.json
!mlblines/mlbdata/analysis_history.json
!mlblines/mlbdata/latest_analysis.json
!mlblines/mlbdata/backtest_results.json

# Market-benchmark snapshots — same perishable-record reasoning as the NHL
# block above: written by CI on an ephemeral runner, lost if not committed.
!mlblines/mlbdata/market_snapshots/

# Misc
.DS_Store
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
*.log
*.swp
*.swo

npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Testing
/coverage
